// 型の検査（pnpm run typecheck）と ESLint の型つき規則が使う。src・test・設定をまとめて見て、何も書き出さない。
// build は無い。src/ は bin/roster と skill が node で直に動かす（Node が型を消して動かす）。
// erasableSyntaxOnly: Node は消せる型しか扱えないので、enum など消せない書き方を止める。
// allowImportingTsExtensions: node が直に読めるように、import の先を .ts と書く。
{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "test", "*.config.ts"]
}
