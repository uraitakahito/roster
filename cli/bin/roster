#!/bin/sh
# roster: src/cli.ts を、この repo の .node-version の Node で直に動かす（Node が型を消して動かすので build は要らない）。
# nodenv の node の shim は、node に渡した script の folder から .node-version を探す。
# ~/.local/bin/roster のような repo の外の symlink を #!/usr/bin/env node で直に動かすと、探す先がその symlink の
# folder になり、作業する folder の .node-version で動いてしまう。だから readlink -f で本当の在り処を求め、
# その path を node に渡す（nodenv が無ければ、ただ node で動かすだけ）。
# 起こせない時（node_modules・node が無い）は 2 で終わる。hook（guard）は 2 の時だけ命令を止め、ほかの数では止めずに通すので、
# 1 で終わると、guard が走らないまま全ての担当の Bash が通ってしまう（AI-36 の review-33）。
set -eu
cli=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
if [ ! -d "$cli/node_modules" ]; then
  # この時は guard も起きず、担当の Bash はみな止まるので、入れるのは Product Manager が自分の terminal で打つ。
  echo "roster: $cli/node_modules がありません。Product Manager が自分の terminal で cd $cli && pnpm install --frozen-lockfile を打ってください（担当の Bash は、入れるまで guard が止める）" >&2
  exit 2
fi
# cmux の通知の hook のように、PATH が macOS の既定（/usr/bin:/bin:/usr/sbin:/sbin）だけで呼ばれた時のため、
# node（nodenv の shim）と cmux（app の中）を自分で見つける。だから hook の命令に Node や cmux の path を書かなくてよい。
# PATH に node・cmux があれば（shell から打った時）何も足さない。
if ! command -v node >/dev/null 2>&1; then
  shims="${NODENV_ROOT:-${HOME:-}/.nodenv}/shims"
  if [ ! -x "$shims/node" ]; then
    echo "roster: node が見つかりません（PATH と $shims/node を探した）" >&2
    exit 2
  fi
  PATH="$shims:$PATH"
fi
command -v cmux >/dev/null 2>&1 || PATH="$PATH:/Applications/cmux.app/Contents/Resources/bin"
export PATH
# 手を止めている間に待つ hook（roster mail wait。引数の無い形）は、機械に NATS の CLI があれば、待つ所だけを CLI に任せる
# （Node.js の process を居続けさせない。無ければ、今までどおり Node.js で待つ）。
if [ "$#" -eq 2 ] && [ "$1" = mail ] && [ "$2" = wait ]; then
  exec "$cli/bin/roster-mail-wait" "$cli/src/cli.ts"
fi
exec node "$cli/src/cli.ts" "$@"
