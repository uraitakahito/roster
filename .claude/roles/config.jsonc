// この repo で TPM 担当を起こしたときの設定（書き方は docs-site の設定のページ）。書いていない欄は既定のまま。
{
  // 課題の記録は Jira（acli が login している site。今は future-gadget-laboratory.atlassian.net の AI）に書く。
  "tracker": "jira",
  // roster push が、push の前に流す確かめ（書き方は docs-site の設定のページの「push」）。CI（test.yml の test・site.yml）の中で手元で速く流せる物。
  // origin/main のこの欄を読むので、変えた一覧は merge の後から効く。e2e（nats-e2e.yml・pagetray-e2e.yml）と生成の検査（test.yml の gen）は CI に任せる。
  // 長さ（2026-11-28 に一時の worktree で測った）: 型 2 秒・lint 5〜6 秒・doccheck 2 秒・試験 21 秒・docs の check 2〜4 秒・format 1 秒。
  "push": {
    "checks": [
      {
        "name": "cli-typecheck",
        "dir": "cli",
        "run": ["pnpm", "run", "typecheck"],
      },
      { "name": "cli-lint", "dir": "cli", "run": ["pnpm", "run", "lint"] },
      {
        "name": "cli-doccheck",
        "dir": "cli",
        "run": ["pnpm", "run", "doccheck"],
      },
      { "name": "cli-test", "dir": "cli", "run": ["pnpm", "test"] },
      {
        "name": "docs-check",
        "dir": "docs-site",
        "run": ["pnpm", "run", "check"],
      },
      {
        "name": "docs-format",
        "dir": "docs-site",
        "run": ["pnpm", "run", "format:check"],
      },
    ],
  },
  "infra": {
    // ページの置き場（別の repo の pagetray の image で動かす container と、DB を置く volume）。
    // 止めると担当はページを置けず、volume を消すと置かれたページの記録（役割・workspace の ID）が消える。
    // 起こし方は docs-site の運用のページの「ページの置き場（pagetray）」と、pagetray の docs の「動かす」（https://uraitakahito.github.io/pagetray/run.html）。
    // guard の当て方は docs-site の設定のページの「環境の手続き」。要るところだけ:
    // - 項目は命令の語で当て、末尾に * の語は前方一致（pagetray-data* は volume の pagetray-data-v1 と -v の値 pagetray-data-v1:/data に当たる）。
    //   container の命令の旗はそろえてから当てるので、--name=…・--volume …・--mount …,source=… も、--name …・-v … の項目で当たる。
    //   語で当たらなくても、命令の字に項目の字（--name=… と --volume … の書き方も）が含まれれば止める。
    // - 名を宣言した container（--name の項目）と volume（-v の項目）を的にする container の命令は、ここに書いていない動詞
    //   （exec・cp・commit・export など）でも止まる。読むだけの logs・inspect・stats・ls（volume は inspect・ls）は通る（t-d37r）。
    // 裸の「pagetray-data」は書かない（命令の字に含まれれば止まるので、volume の名を grep する読む命令まで止めるため）。
    "pagetray": {
      "guard": "tpm",
      // container の名は pagetray.box（pagetray 1.2.0 から。同じ network の callboard が、DNS の domain box で名で引く。AI-32）。
      // 前の名 pagetray の項目も残す（前の名で動かしている間と、前の名で起こし直す試みを止めるため）。
      "match": [
        "--name pagetray.box",
        "container start pagetray.box",
        "container stop pagetray.box",
        "container kill pagetray.box",
        "container delete pagetray.box",
        "container rm pagetray.box",
        "--name pagetray",
        "container start pagetray",
        "container stop pagetray",
        "container kill pagetray",
        "container delete pagetray",
        "container rm pagetray",
        "container volume delete pagetray-data*",
        "container volume rm pagetray-data*",
        "-v pagetray-data*",
        // volume の略の v（container v rm …）。語が volume と違うので、略の形も並べる（t-9tac）。
        "container v delete pagetray-data*",
        "container v rm pagetray-data*",
      ],
    },
    // メッセージキュー（NATS JetStream の container と、預かった物を置く volume）。担当どうしのメッセージを預かって配る。
    // 止めると担当はメッセージを送れず、volume を消すと、届いていないメッセージと記録が消える。
    // 起こし方は docs-site の運用のページの「メッセージキュー（NATS）」。volume は roster-nats-data。項目の書き方は pagetray と同じ。
    "nats": {
      "guard": "tpm",
      "match": [
        "--name roster-nats",
        "container start roster-nats",
        "container stop roster-nats",
        "container kill roster-nats",
        "container delete roster-nats",
        "container rm roster-nats",
        // -v の値は roster-nats-data:/data の 1 語なので、* が要る。
        "container volume delete roster-nats-data*",
        "container volume rm roster-nats-data*",
        "-v roster-nats-data*",
        "container v delete roster-nats-data*",
        "container v rm roster-nats-data*",
      ],
    },
    // 手元で image を build する builder（Apple Container の container build が使う container。名は buildkit）。
    // roster を動かす機械に 1 つで、並べて動く担当がみな使う。止める・消す・作り直すと、ほかの担当の build が途中で落ちる。
    // container build は builder が止まっていれば自分で起こすので、担当は builder start を打たない（CPU・メモリなどの旗を付けた start は、
    // 動いている builder を止めて作り直す）。container build と container builder status は止めない（どの match も含まない）。
    // build に -c・-m・--ssh・--dns を付けても作り直すが、字 1 つでは止められないので、docs-site の運用のページに書く。
    "builder": {
      "guard": "tpm",
      "match": [
        "--name buildkit",
        "container builder start",
        "container builder stop",
        "container builder delete",
        "container builder rm",
        "container stop buildkit",
        "container kill buildkit",
        "container delete buildkit",
        "container rm buildkit",
      ],
    },
    // container の仕組みそのものと、名を取らずにまとめて消す命令（t-9tac）。どれも、castlist（pm-only）の container か volume に届き得る:
    // system stop は仕組みごと止め、prune は止めてある container を、volume prune は container の無い volume（作り直しの間の castlist-data-v1 など）を消す。
    // castlist より緩くできないので pm-only。s・v・n は system・volume・network の略。
    // --all・-a・$(…)・xargs で名を書かずに選ぶ stop・kill・rm・volume rm は、guard が、名を書いた項目の動詞から引いて当てる（ここには書かない）。
    // 名を宣言しないこの環境の項目は、語が続けて並ぶ時だけ当たる（間は旗とその値だけ）。container image prune・container exec x make clean は当たらない。
    "container-system": {
      "guard": "pm-only",
      "match": [
        "container system stop",
        "container s stop",
        "container prune",
        "container clean",
        "container volume prune",
        "container v prune",
        "container network prune",
        "container n prune",
        "container network delete --all",
        "container network delete -a",
        "container network rm --all",
        "container network rm -a",
        "container n delete --all",
        "container n delete -a",
        "container n rm --all",
        "container n rm -a",
      ],
    },
  },
}
