// pnpm run build が使う。src/ だけを dist/ に書き出す（bin/tpm は dist/cli.js への symlink）。
// src/release-age.ts は skill が node で直に動かすので書き出さない。
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["src/release-age.ts"]
}
