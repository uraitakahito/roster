// 型の検査（pnpm run typecheck）と ESLint の型つき規則が使う。src・test・dependabot の skill セットの TypeScript（release-age の型と試験）・設定をまとめて見て、何も書き出さない。
// 書き出しは tsconfig.build.json（pnpm run build）。
{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "dependabot/.claude/skills/**/*.ts", "dependabot/.claude/skills/**/*.mts", "*.config.ts"]
}
